{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "description": "E2E tests using MS Playwright",
  "main": "index.js",
  "author": "ugioni",
  "license": "ISC",
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^25.6.0",
    "c8": "^10.1.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "sicolo": "^1.0.1"
  },
  "scripts": {
    "clean": "rimraf ./artifacts && mkdirp ./artifacts",
    "format": "prettier --write \"**/**.[jt]s?(x)\"",
    "verify": "prettier --check \"**/**.[jt]s?(x)\"",
    "typecheck": "tsc --noEmit",
    "scenario": "npx playwright test src/scenarios/SauceDemo.spec.ts --output artifacts/media --workers 1",
    "test": "npx playwright test --output artifacts/media --workers 4",
    "debug": "npx playwright test --output artifacts/media --debug --workers 1",
    "ui": "npx playwright test --output artifacts/media --ui --workers 1",
    "show-report": "npx playwright show-report artifacts/report",
    "actions": "npx playwright test --output artifacts/media --workers 1",
    "coverage": "c8 playwright test --output artifacts/media --workers 1",
    "ci": "npm run clean && npm run verify && npm run typecheck && npm run coverage"
  }
}
